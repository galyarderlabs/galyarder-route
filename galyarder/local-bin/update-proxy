NODE_BIN="$(find_service_node)"
NODE_DIR="$(dirname "$NODE_BIN")"
NPM_BIN="$NODE_DIR/npm"
OMNI_BIN="$NODE_DIR/omniroute"
[[ -x "$NPM_BIN" ]] || die "npm not found beside service node: $NPM_BIN"
[[ -x "$OMNI_BIN" ]] || die "omniroute not found beside service node: $OMNI_BIN"
case "$PATCH_MODE" in
  aliases|full|none) ;;
  *) die "Unknown OMNIROUTE_PATCH_MODE=$PATCH_MODE (expected aliases, full, or none)" ;;
esac
if [[ "$PATCH_MODE" == "full" ]]; then
  [[ -x "$PATCH_SCRIPT" ]] || die "patch script not executable: $PATCH_SCRIPT"
fi

ROOT_BEFORE="$(find_omniroute_root || true)"
CURRENT_VERSION="$("$OMNI_BIN" --version | tail -n1 | tr -d '[:space:]')"
SERVICE_WAS_ACTIVE="$(systemctl --user is-active "$SERVICE" 2>/dev/null || true)"
DB_BACKUP=""

log "Service node: $("$NODE_BIN" -p 'process.version + " abi=" + process.versions.modules')"
log "Current OmniRoute: $CURRENT_VERSION"
log "Target OmniRoute: $TARGET_VERSION"
log "Patch mode: $PATCH_MODE"
[[ -n "$ROOT_BEFORE" ]] && log "Package root: $ROOT_BEFORE"

if [[ "$MODE" == "check" ]]; then
  log "Check mode: no update will be performed"
  [[ -f "$DB" ]] || die "DB not found: $DB"
  sqlite3 "$DB" 'pragma integrity_check;' | grep -qx 'ok' || die "DB integrity check failed"
  if [[ "$PATCH_MODE" == "full" ]]; then
    [[ -x "$PATCH_SCRIPT" ]] || die "patch script not executable: $PATCH_SCRIPT"
  fi
  cleanup_empty_probe_files
  if systemctl --user is-active "$SERVICE" >/dev/null 2>&1 && health_check; then
    log "Service healthy"
  else
    warn "Service is not healthy or not reachable"
  fi
  log "Check complete"
  exit 0
fi

DB_BACKUP="$(backup_db | tail -n1)"
cleanup_empty_probe_files

rollback_on_error() {
  local status=$?
  warn "Update failed with exit code $status"
  if [[ -n "$DB_BACKUP" ]]; then
    restore_db "$DB_BACKUP"
  fi
  if [[ "$SERVICE_WAS_ACTIVE" == "active" ]]; then
    systemctl --user start "$SERVICE" >/dev/null 2>&1 || true
  fi
  exit "$status"
}
trap rollback_on_error ERR

log "Stopping $SERVICE for package update"
systemctl --user stop "$SERVICE" || true

log "Installing omniroute@$TARGET_VERSION"
env PATH="$NODE_DIR:/usr/local/bin:/usr/bin:/bin" "$NPM_BIN" install -g "omniroute@$TARGET_VERSION"

UPDATED_VERSION="$("$OMNI_BIN" --version | tail -n1 | tr -d '[:space:]')"
log "Installed OmniRoute: $UPDATED_VERSION"

case "$PATCH_MODE" in
  aliases)
    apply_alias_policy
    ;;
  full)
    log "Reapplying legacy full local dashboard patch"
    "$PATCH_SCRIPT"
    ;;
  none)
    warn "Skipping local patches by request"
    ;;
esac

cleanup_empty_probe_files

log "Starting $SERVICE"
systemctl --user start "$SERVICE"

log "Waiting for healthy service"
for _ in {1..30}; do
  if health_check; then
    trap - ERR
    log "Update complete: $CURRENT_VERSION -> $UPDATED_VERSION"
    log "DB backup kept at: $DB_BACKUP"
    exit 0
  fi
  sleep 1
done

die "OmniRoute did not become healthy after update"
