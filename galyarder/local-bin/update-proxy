#!/usr/bin/env bash
set -euo pipefail

SERVICE="${OMNIROUTE_SERVICE:-omniroute.service}"
PATCH_SCRIPT="${OMNIROUTE_PATCH_SCRIPT:-$HOME/.omniroute/patches/apply-g-agent-cli-tools-patch.sh}"
PATCH_MODE="${OMNIROUTE_PATCH_MODE:-aliases}"
DATA_DIR="${OMNIROUTE_DATA_DIR:-$HOME/.omniroute}"
DB="$DATA_DIR/storage.sqlite"
BACKUP_DIR="$DATA_DIR/db_backups"
TARGET_VERSION="${1:-latest}"
MODE="update"
if [[ "${1:-}" == "--check" || "${1:-}" == "check" ]]; then
  MODE="check"
  TARGET_VERSION="latest"
elif [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<'EOF'
Usage:
  update-proxy              Update OmniRoute to npm latest safely
  update-proxy 3.7.5        Update/install a specific OmniRoute version
  update-proxy --check      Verify service, DB, patch mode, and aliases only

What update mode does:
  - Checks and backs up ~/.omniroute/storage.sqlite
  - Stops omniroute.service during npm install
  - Installs omniroute with the Node/npm used by the service
  - Reapplies critical local alias policy by default
  - Verifies OmniRoute health before finishing

Patch modes:
  OMNIROUTE_PATCH_MODE=aliases  Keep short aliases pinned to cx/github/gemini-cli
  OMNIROUTE_PATCH_MODE=full     Reapply legacy dashboard/g-agent bundle patch
  OMNIROUTE_PATCH_MODE=none     Skip local patches entirely
EOF
  exit 0
fi

log() { printf '\033[1;34m[update-proxy]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[update-proxy]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[update-proxy]\033[0m %s\n' "$*" >&2; exit 1; }

find_service_node() {
  local unit node_path
  unit="$(systemctl --user cat "$SERVICE" 2>/dev/null || true)"
  node_path="$(printf '%s\n' "$unit" | sed -n 's#^ExecStart=\([^ ]*/node\) .*#\1#p' | head -n1)"
  if [[ -n "$node_path" && -x "$node_path" ]]; then
    printf '%s\n' "$node_path"
    return 0
  fi
  command -v node
}

find_omniroute_root() {
  local unit exec_path root
  unit="$(systemctl --user cat "$SERVICE" 2>/dev/null || true)"
  exec_path="$(printf '%s\n' "$unit" | sed -n 's#.* \(/[^ ]*/lib/node_modules/omniroute/bin/omniroute\.mjs\).*#\1#p' | head -n1)"
  if [[ -n "$exec_path" ]]; then
    root="$(dirname "$(dirname "$exec_path")")"
    if [[ -d "$root/app/.next" ]]; then
      printf '%s\n' "$root"
      return 0
    fi
  fi
  return 1
}

health_check() {
  local health
  health="$(curl -fsS http://127.0.0.1:20128/api/monitoring/health 2>/dev/null || true)"
  [[ "$health" == *'"status":"healthy"'* ]]
}

cleanup_empty_probe_files() {
  local qdir="$BACKUP_DIR/probe_failed_quarantine_$(date +%Y%m%d_%H%M%S)"
  local moved=0
  shopt -s nullglob
  for f in "$DATA_DIR"/storage.sqlite.probe-failed-*; do
    if [[ ! -s "$f" ]]; then
      mkdir -p "$qdir"
      mv "$f" "$qdir/"
      moved=1
    fi
  done
  shopt -u nullglob
  if [[ "$moved" == "1" ]]; then
    log "Moved empty probe-failed DB files to $qdir"
  fi
}

backup_db() {
  mkdir -p "$BACKUP_DIR"
  [[ -f "$DB" ]] || die "DB not found: $DB"

  local ts backup
  ts="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
  backup="$BACKUP_DIR/db_${ts}_pre-update-proxy.sqlite"

  log "Checking DB integrity"
  sqlite3 "$DB" 'pragma integrity_check;' | grep -qx 'ok' || die "DB integrity check failed"

  log "Creating SQLite backup: $backup"
  sqlite3 "$DB" ".backup '$backup'"
  sqlite3 "$backup" 'pragma integrity_check;' | grep -qx 'ok' || die "Backup integrity check failed"
  printf '%s\n' "$backup"
}

restore_db() {
  local backup="$1"
  if [[ -f "$backup" ]]; then
    warn "Restoring DB backup: $backup"
    cp -f "$backup" "$DB"
  fi
}

